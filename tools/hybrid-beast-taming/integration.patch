+// Beast taming is authorized by mode, selected classes and learned control spell.
+bool HeroCanTameBeast(Player const* p) {
+ if (!p || !p->HasSpell(1515)) return false;
+ auto mode=HeroTrainer::Current(p);
+ if (mode==HeroTrainer::Mode::Hero) return true;
+ if (mode!=HeroTrainer::Mode::ClassPlus && mode!=HeroTrainer::Mode::Hybrid) return false;
+ return (HeroEquipmentClassMask(p)&HeroEquipment::Bit(CLASS_HUNTER))!=0;
+}
